{
    "id": null,
    "uid": "payment-metrics",
    "title": "Payment Metrics",
    "tags": ["payment", "raillo"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "type": "row",
        "title": "결제 현황 (Overview)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "collapsed": false
      },
      {
        "type": "gauge",
        "title": "결제 성공률",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 90 },
                { "color": "green", "value": 99 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum(rate(payment_confirm_success_total{application=\"raillo-backend\"}[1m])) / (sum(rate(payment_confirm_success_total{application=\"raillo-backend\"}[1m])) + sum(rate(payment_confirm_failure_total{application=\"raillo-backend\"}[1m]))) * 100",
            "legendFormat": "성공률",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        }
      },
      {
        "type": "stat",
        "title": "총 결제 준비",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "blue", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "payment_prepare_total{application=\"raillo-backend\"}",
            "legendFormat": "결제 준비",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "type": "stat",
        "title": "총 결제 승인",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "payment_confirm_success_total{application=\"raillo-backend\"}",
            "legendFormat": "승인 성공",
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          },
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "type": "row",
        "title": "결제 처리량 (Throughput)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "결제 준비 RPS",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "pointSize": 5,
              "showPoints": "auto"
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "rate(payment_prepare_total{application=\"raillo-backend\"}[1m])",
            "legendFormat": "prepare RPS",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "결제 승인 성공/실패 RPS",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "pointSize": 5,
              "showPoints": "auto"
            },
            "unit": "reqps"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "성공" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "실패" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            }
          ]
        },
        "targets": [
          {
            "expr": "rate(payment_confirm_success_total{application=\"raillo-backend\"}[1m])",
            "legendFormat": "성공",
            "refId": "A"
          },
          {
            "expr": "sum(rate(payment_confirm_failure_total{application=\"raillo-backend\"}[1m]))",
            "legendFormat": "실패",
            "refId": "B"
          }
        ]
      },
      {
        "type": "row",
        "title": "실패 분석 (Failure Analysis)",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "실패 원인별 RPS",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 30,
              "stacking": { "mode": "normal" },
              "showPoints": "auto"
            },
            "unit": "reqps"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (reason) (rate(payment_confirm_failure_total{application=\"raillo-backend\"}[1m]))",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "piechart",
        "title": "실패 원인 분포",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (reason, error_code) (increase(payment_confirm_failure_total{application=\"raillo-backend\"}[5m]))",
            "legendFormat": "{{reason}} / {{error_code}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          },
          "pieType": "donut",
          "reduceOptions": {
            "calcs": ["lastNotNull"]
          }
        }
      },
      {
        "type": "row",
        "title": "Toss API 인프라",
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
        "collapsed": false
      },
      {
        "type": "timeseries",
        "title": "Toss API 응답시간 (P50/P95/P99)",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "unit": "s"
          },
          "overrides": [
            {
              "matcher": { "id": "byRegexp", "options": ".* P50$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byRegexp", "options": ".* P95$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byRegexp", "options": ".* P99$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            }
          ]
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le, operation) (rate(toss_api_duration_seconds_bucket{application=\"raillo-backend\", outcome=\"success\"}[1m])))",
            "legendFormat": "{{operation}} P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(toss_api_duration_seconds_bucket{application=\"raillo-backend\", outcome=\"success\"}[1m])))",
            "legendFormat": "{{operation}} P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(toss_api_duration_seconds_bucket{application=\"raillo-backend\", outcome=\"success\"}[1m])))",
            "legendFormat": "{{operation}} P99",
            "refId": "C"
          }
        ]
      },
      {
        "type": "barchart",
        "title": "Toss 에러코드 Top 5",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" }
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "topk(5, sum by (operation, toss_code) (increase(toss_api_failure_total{application=\"raillo-backend\"}[5m])))",
            "legendFormat": "{{operation}} / {{toss_code}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "options": {
          "orientation": "horizontal",
          "showValue": "always",
          "barWidth": 0.7
        }
      },
      {
        "type": "timeseries",
        "title": "Toss API 진행 중 요청 age (max/avg/p95/p99)",
        "description": "지금 이 순간 진행 중인 Toss 호출의 age 분포. max·평균·p95·p99를 함께 보여준다. avg는 (gsum/gcount)로 파생, percentile은 활성 히스토그램 버킷 스냅샷에서 histogram_quantile로 계산한다. 완료 데이터 없이도 Toss 지연·hang을 즉시 감지한다.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 5,
              "showPoints": "auto"
            },
            "unit": "s"
          },
          "overrides": [
            {
              "matcher": { "id": "byRegexp", "options": ".*max$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byRegexp", "options": ".*p99$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byRegexp", "options": ".*p95$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byRegexp", "options": ".*avg$" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            }
          ]
        },
        "targets": [
          {
            "expr": "sum by (operation) (toss_api_active_seconds_max{application=\"raillo-backend\"})",
            "legendFormat": "{{operation}} max",
            "refId": "A"
          },
          {
            "expr": "sum by (operation) (toss_api_active_seconds_gsum{application=\"raillo-backend\"}) / sum by (operation) (toss_api_active_seconds_gcount{application=\"raillo-backend\"})",
            "legendFormat": "{{operation}} avg",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.95, sum by (le, operation) (toss_api_active_seconds_bucket{application=\"raillo-backend\"}))",
            "legendFormat": "{{operation}} p95",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.99, sum by (le, operation) (toss_api_active_seconds_bucket{application=\"raillo-backend\"}))",
            "legendFormat": "{{operation}} p99",
            "refId": "D"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Toss API 진행 중 요청 수",
        "description": "operation별 현재 진행 중 요청 개수. LongTaskTimer의 active_count 시리즈로, 배포 직후 catch-up·Toss 지연·풀 고갈을 개수 관점에서 관측한다.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "sum by (operation) (toss_api_active_seconds_gcount{application=\"raillo-backend\"})",
            "legendFormat": "{{operation}}",
            "refId": "A"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Toss HTTP 커넥션 풀 상태",
        "description": "Apache HttpClient 5 커넥션 풀의 실시간 상태. leased(사용 중)·available(유휴)·pending(획득 대기)을 함께 보여준다. pending이 지속적으로 0보다 크면 풀 부족 신호로 maxTotal 또는 maxPerRoute 상향을 검토해야 한다.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "leased (사용 중)" },
              "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "available (유휴)" },
              "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
            },
            {
              "matcher": { "id": "byName", "options": "pending (획득 대기)" },
              "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
            }
          ]
        },
        "targets": [
          {
            "expr": "toss_pool_connections_active{application=\"raillo-backend\"}",
            "legendFormat": "leased (사용 중)",
            "refId": "A"
          },
          {
            "expr": "toss_pool_connections_idle{application=\"raillo-backend\"}",
            "legendFormat": "available (유휴)",
            "refId": "B"
          },
          {
            "expr": "toss_pool_connections_pending{application=\"raillo-backend\"}",
            "legendFormat": "pending (획득 대기)",
            "refId": "C"
          }
        ]
      },
      {
        "type": "timeseries",
        "title": "Toss HTTP 커넥션 풀 pending",
        "description": "커넥션 획득 대기 요청 수 단독 그래프. 이 값이 지속적으로 0보다 크면 풀 크기가 실제 부하 대비 부족하다는 강한 신호. 알람 임계값으로 사용하기 좋다.",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "red" },
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 20,
              "showPoints": "auto"
            },
            "unit": "short"
          },
          "overrides": []
        },
        "targets": [
          {
            "expr": "toss_pool_connections_pending{application=\"raillo-backend\"}",
            "legendFormat": "pending",
            "refId": "A"
          }
        ]
      }
    ]
}
