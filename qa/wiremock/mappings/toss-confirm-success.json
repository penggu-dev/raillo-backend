{
  "priority": 10,
  "request": {
    "method": "POST",
    "urlPathPattern": "/v1/payments/confirm"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"],
    "body": "{\"paymentKey\": \"{{jsonPath request.body '$.paymentKey'}}\", \"orderId\": \"{{jsonPath request.body '$.orderId'}}\", \"method\": \"카드\", \"totalAmount\": {{jsonPath request.body '$.amount'}}, \"status\": \"DONE\"}"
  }
}
